// The package's C, where it measures faster than Goose (docs/decisions.md):
// CRC-32 folded with PCLMULQDQ on x86-64 and PMULL on arm64, and DEFLATE level
// 1's matcher and the symbol coder. The CRC function that uses the
// instructions carries its own target attribute, so the C needs no -march and
// runs on any CPU of its architecture.
c_sources = ["shim/crc32.c", "shim/deflate.c"];
// The shim's _Static_assert is C11, which MSVC takes only when asked.
c_flags_msvc = ["/std:c11"];
// build/ holds the compiler scripts/goose.sh fetches, and bench/compare.sh's
// extracted packages.
exclude = ["build"];
